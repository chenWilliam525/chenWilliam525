<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.PostMapper">

    <sql id="Base_Column_List">
        id,username,name,number,time,content
    </sql>

    <select id="selectAll" resultType="com.example.entity.Post">
        select
        <include refid="Base_Column_List" />
        from post
        <where>
            <if test="id != null"> and id= #{id}</if>
            <if test="username != null"> and title like concat('%', #{username}, '%')</if>
            <if test="name != null"> and title like concat('%', #{name}, '%')</if>
            <if test="number != null"> and title like concat('%', #{number}, '%')</if>
            <if test="time != null"> and time= #{time}</if>
            <if test="content != null"> and content= #{content}</if>

        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.example.entity.Post">
        select
        <include refid="Base_Column_List" />
        from post
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from post
        where  id = #{id}
    </delete>

    <insert id="insert" parameterType="com.example.entity.Post" useGeneratedKeys="true">
        insert into post
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">id,</if>
                <if test="username != null">username,</if>
                <if test="name != null">name,</if>
                <if test="number != null">number,</if>
                <if test="time != null">time,</if>
                <if test="content != null">content,</if>


        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>
                <if test="username != null">#{username},</if>
                <if test="name != null">#{name},</if>
                <if test="number != null">#{number},</if>
                <if test="time != null">#{time},</if>
                <if test="content != null">#{content},</if>


        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.Post">
        update post
        <set>
            <if test="content != null">
                content = #{content},
            </if>
            <if test="time != null">
                time = #{time},
            </if>
            <if test="username != null">
                user = #{username},
            </if>
        </set>
        where id = #{id} 
    </update>

</mapper>