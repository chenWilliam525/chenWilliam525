{"ast":null,"code":"export default {\n  name: 'Home',\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      notices: [],\n      loading: false // 用于显示加载状态\n    };\n  },\n\n  created() {\n    this.loadNotices();\n  },\n  methods: {\n    loadNotices() {\n      this.loading = true;\n      this.$request.get('/notice/selectAll').then(res => {\n        if (res.code === '200') {\n          this.notices = res.data || [];\n        } else {\n          this.$message.error('获取公告失败');\n        }\n      }).catch(err => {\n        this.$message.error('请求失败，请稍后再试');\n      }).finally(() => {\n        this.loading = false;\n      });\n    },\n    // 查看公告详情\n    viewNotice(row) {\n      this.$message.info(`查看公告: ${row.title}`);\n      // 这里可以根据需求展示详细信息\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","notices","loading","created","loadNotices","methods","$request","get","then","res","code","$message","error","catch","err","finally","viewNotice","row","info","title"],"sources":["src/views/front/Activity.vue"],"sourcesContent":["<template>\r\n  <div class=\"container\">\r\n    <el-card class=\"notice-card\" shadow=\"hover\" style=\"margin: 20px;\">\r\n      <div class=\"card-title\">公告列表</div>\r\n\r\n      <!-- 公告表格 -->\r\n      <el-table :data=\"notices\" border style=\"width: 100%\" v-loading=\"loading\">\r\n        <el-table-column label=\"活动标题\" prop=\"title\" width=\"200\">\r\n        </el-table-column>\r\n        <el-table-column label=\"发布时间\" prop=\"time\" width=\"180\">\r\n        </el-table-column>\r\n        <el-table-column label=\"操作\" width=\"150\">\r\n          <template slot-scope=\"scope\">\r\n            <el-button size=\"mini\" @click=\"viewNotice(scope.row)\" type=\"primary\">查看</el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n    </el-card>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'Home',\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      notices: [],\r\n      loading: false,  // 用于显示加载状态\r\n    };\r\n  },\r\n  created() {\r\n    this.loadNotices();\r\n  },\r\n  methods: {\r\n    loadNotices() {\r\n      this.loading = true;\r\n      this.$request.get('/notice/selectAll')\r\n        .then(res => {\r\n          if (res.code === '200') {\r\n            this.notices = res.data || [];\r\n          } else {\r\n            this.$message.error('获取公告失败');\r\n          }\r\n        })\r\n        .catch(err => {\r\n          this.$message.error('请求失败，请稍后再试');\r\n        })\r\n        .finally(() => {\r\n          this.loading = false;\r\n        });\r\n    },\r\n\r\n    // 查看公告详情\r\n    viewNotice(row) {\r\n      this.$message.info(`查看公告: ${row.title}`);\r\n      // 这里可以根据需求展示详细信息\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 20px;\r\n  background-color: #f5f5f5;\r\n  min-height: 100vh;\r\n}\r\n\r\n.notice-card {\r\n  width: 100%;\r\n  max-width: 1000px;\r\n  background-color: #fff;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n}\r\n\r\n.card-title {\r\n  font-size: 24px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n  text-align: center;\r\n}\r\n\r\n.el-table {\r\n  width: 100%;\r\n  margin-top: 20px;\r\n}\r\n\r\n.el-table .cell {\r\n  text-align: center;\r\n}\r\n\r\n.el-button {\r\n  width: 100%;\r\n  font-size: 14px;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .notice-card {\r\n    padding: 15px;\r\n  }\r\n\r\n  .card-title {\r\n    font-size: 20px;\r\n  }\r\n\r\n  .el-table {\r\n    font-size: 12px;\r\n  }\r\n\r\n  .el-table-column {\r\n    padding: 5px 10px;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAuBA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,OAAA;IACA;EACA;;EACAC,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,