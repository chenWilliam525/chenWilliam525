{"ast":null,"code":"export default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      // 获取当前用户信息\n      content: null,\n      // 投诉内容\n      tableData: [] // 存放历史反馈的表格数据\n    };\n  },\n\n  created() {\n    this.load(); // 页面加载时加载历史反馈数据\n  },\n\n  methods: {\n    // 加载历史反馈数据，只筛选与当前用户姓名一致的投诉\n    load() {\n      this.$request.get('/complaint/selectAll').then(res => {\n        if (res.code === '200') {\n          // 通过当前用户的姓名筛选反馈数据\n          this.tableData = res.data.filter(item => item.name === this.user.name);\n        } else {\n          this.$message.error(res.msg); // 错误提示\n        }\n      });\n    },\n\n    // 提交反馈\n    commit() {\n      let data = {\n        content: this.content,\n        // 投诉内容\n        username: this.user.username // 用户名\n      };\n\n      this.$request.post('/complaint/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('反馈成功，我们会认真考虑您反馈的信息'); // 成功提示\n          this.content = null; // 清空输入框\n          this.load(); // 重新加载历史反馈数据\n        } else {\n          this.$message.error(res.msg); // 错误提示\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","user","JSON","parse","localStorage","getItem","content","tableData","created","load","methods","$request","get","then","res","code","filter","item","name","$message","error","msg","commit","username","post","success"],"sources":["src/views/front/Complaint.vue"],"sourcesContent":["\r\n<template>\r\n  <div style=\"width: 50%; margin: 30px auto\">\r\n    <div style=\"color: #666666; font-size: 16px\">欢迎发表您宝贵的意见，我们会认真考虑</div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-input type=\"textarea\" :rows=\"4\" v-model=\"content\" placeholder=\"请输入您的投诉或者建议\"></el-input>\r\n    </div>\r\n    <div style=\"margin-top: 20px; text-align: right\">\r\n      <el-button style=\"padding: 10px 50px\" type=\"primary\" @click=\"commit\">提交</el-button>\r\n    </div>\r\n    <div style=\"font-size: 16px; margin-top: 30px; font-weight: bold; color: #666666\">\r\n      历史反馈的问题：{{ tableData.length }}\r\n    </div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"content\" label=\"反馈内容\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"time\" label=\"提交时间\" width=\"150px\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"业主姓名\" width=\"100px\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"处理状态\" width=\"100px\">\r\n          <template v-slot=\"scope\">\r\n            <el-tag type=\"success\" v-if=\"scope.row.status === '已处理'\">已处理</el-tag>\r\n            <el-tag type=\"danger\" v-else>待处理</el-tag>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),  // 获取当前用户信息\r\n      content: null,  // 投诉内容\r\n      tableData: []    // 存放历史反馈的表格数据\r\n    }\r\n  },\r\n  created() {\r\n    this.load();  // 页面加载时加载历史反馈数据\r\n  },\r\n  methods: {\r\n    // 加载历史反馈数据，只筛选与当前用户姓名一致的投诉\r\n    load() {\r\n      this.$request.get('/complaint/selectAll').then(res => {\r\n        if (res.code === '200') {\r\n          // 通过当前用户的姓名筛选反馈数据\r\n          this.tableData = res.data.filter(item => item.name === this.user.name);\r\n        } else {\r\n          this.$message.error(res.msg);  // 错误提示\r\n        }\r\n      });\r\n    },\r\n    // 提交反馈\r\n    commit() {\r\n      let data = {\r\n        content: this.content,            // 投诉内容\r\n        username: this.user.username      // 用户名\r\n      };\r\n      this.$request.post('/complaint/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('反馈成功，我们会认真考虑您反馈的信息');  // 成功提示\r\n          this.content = null;  // 清空输入框\r\n          this.load();  // 重新加载历史反馈数据\r\n        } else {\r\n          this.$message.error(res.msg);  // 错误提示\r\n        }\r\n      });\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>\r\n"],"mappings":"AA8BA;EACAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MAAA;MACAC,OAAA;MAAA;MACAC,SAAA;IACA;EACA;;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;;EACAC,OAAA;IACA;IACAD,KAAA;MACA,KAAAE,QAAA,CAAAC,GAAA,yBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA;UACA,KAAAR,SAAA,GAAAO,GAAA,CAAAd,IAAA,CAAAgB,MAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAC,IAAA,UAAAjB,IAAA,CAAAiB,IAAA;QACA;UACA,KAAAC,QAAA,CAAAC,KAAA,CAAAN,GAAA,CAAAO,GAAA;QACA;MACA;IACA;;IACA;IACAC,OAAA;MACA,IAAAtB,IAAA;QACAM,OAAA,OAAAA,OAAA;QAAA;QACAiB,QAAA,OAAAtB,IAAA,CAAAsB,QAAA;MACA;;MACA,KAAAZ,QAAA,CAAAa,IAAA,mBAAAxB,IAAA,EAAAa,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAI,QAAA,CAAAM,OAAA;UACA,KAAAnB,OAAA;UACA,KAAAG,IAAA;QACA;UACA,KAAAU,QAAA,CAAAC,KAAA,CAAAN,GAAA,CAAAO,GAAA;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}