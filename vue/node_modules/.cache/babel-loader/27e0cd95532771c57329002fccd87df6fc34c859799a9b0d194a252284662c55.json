{"ast":null,"code":"export default {\n  name: \"Examine\",\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      status: null\n    };\n  },\n  created() {\n    this.load(1);\n  },\n  methods: {\n    // 数据加载方法，分页查询\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/user/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          status: this.status\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    // 重置查询\n    reset() {\n      this.status = null;\n      this.load(1);\n    },\n    // 处理分页变化\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    },\n    // 同意操作\n    handleAgree(row) {\n      this.$confirm('您确定同意吗？', '确认同意', {\n        type: \"info\"\n      }).then(() => {\n        let data = JSON.parse(JSON.stringify(row));\n        data.status = '已同意'; // 修改状态为已同意\n\n        this.updateStatus(data);\n      }).catch(() => {\n        // 取消操作\n      });\n    },\n    // 拒绝操作\n    handleReject(row) {\n      this.$confirm('您确定拒绝吗？', '确认拒绝', {\n        type: \"warning\"\n      }).then(() => {\n        let data = JSON.parse(JSON.stringify(row));\n        data.status = '已拒绝'; // 修改状态为已拒绝\n\n        this.updateStatus(data);\n      }).catch(() => {\n        // 取消操作\n      });\n    },\n    // 更新状态方法\n    updateStatus(data) {\n      this.$request.put('/user/update', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('操作成功');\n          this.load(this.pageNum); // 刷新数据\n        } else {\n          this.$message.error(res.msg); // 错误提示\n        }\n      }).catch(() => {\n        this.$message.error('处理失败');\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","tableData","pageNum","pageSize","total","status","created","load","methods","$request","get","params","then","res","list","reset","handleCurrentChange","handleAgree","row","$confirm","type","stringify","updateStatus","catch","handleReject","put","code","$message","success","error","msg"],"sources":["src/views/manager/Examine.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"search\">\r\n      <el-input placeholder=\"请输入状态查询\" style=\"width: 200px\" v-model=\"status\"></el-input>\r\n      <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">查询</el-button>\r\n      <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\r\n    </div>\r\n\r\n    <div class=\"table\">\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"id\" label=\"序号\" width=\"80\" align=\"center\" sortable></el-table-column>\r\n        \r\n        <el-table-column prop=\"username\" label=\"账号\" width=\"200\" align=\"center\"></el-table-column>\r\n        <el-table-column prop=\"password\" label=\"密码\" width=\"200\" align=\"center\"></el-table-column>\r\n\r\n        <!-- 处理状态 -->\r\n        <el-table-column prop=\"status\" label=\"处理状态\">\r\n          <template v-slot=\"scope\">\r\n            <!-- 显示 status 的值 -->\r\n            <el-tag type=\"success\" v-if=\"scope.row.status === '已同意'\">已同意</el-tag>\r\n            <el-tag type=\"danger\" v-else-if=\"scope.row.status === '已拒绝'\">已拒绝</el-tag>\r\n            <el-tag type=\"warning\" v-else-if=\"scope.row.status === '待审核'\">待审核</el-tag>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"操作\" width=\"180\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            <el-button\r\n                    plain\r\n                    type=\"success\"\r\n                    @click=\"handleAgree(scope.row)\"\r\n                    size=\"mini\"\r\n                    :disabled=\"scope.row.status === '已同意' \">\r\n              同意\r\n            </el-button>\r\n            <el-button\r\n                    plain\r\n                    type=\"danger\"\r\n                    @click=\"handleReject(scope.row)\"\r\n                    size=\"mini\"\r\n                    :disabled=\"scope.row.status === '已同意' || scope.row.status === '已拒绝'\">\r\n              拒绝\r\n            </el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <div class=\"pagination\">\r\n        <el-pagination\r\n                background\r\n                @current-change=\"handleCurrentChange\"\r\n                :current-page=\"pageNum\"\r\n                :page-sizes=\"[5, 10, 20]\"\r\n                :page-size=\"pageSize\"\r\n                layout=\"total, prev, pager, next\"\r\n                :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: \"Examine\",\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      tableData: [],\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      status: null\r\n    }\r\n  },\r\n  created() {\r\n    this.load(1)\r\n  },\r\n  methods: {\r\n    // 数据加载方法，分页查询\r\n    load(pageNum) {\r\n      if (pageNum) this.pageNum = pageNum;\r\n      this.$request.get('/user/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          status: this.status,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data?.list;\r\n        this.total = res.data?.total;\r\n      });\r\n    },\r\n\r\n    // 重置查询\r\n    reset() {\r\n      this.status = null;\r\n      this.load(1);\r\n    },\r\n\r\n    // 处理分页变化\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum);\r\n    },\r\n\r\n    // 同意操作\r\n    handleAgree(row) {\r\n      this.$confirm('您确定同意吗？', '确认同意', { type: \"info\" }).then(() => {\r\n        let data = JSON.parse(JSON.stringify(row));\r\n        data.status = '已同意';  // 修改状态为已同意\r\n\r\n        this.updateStatus(data);\r\n      }).catch(() => {\r\n        // 取消操作\r\n      });\r\n    },\r\n\r\n    // 拒绝操作\r\n    handleReject(row) {\r\n      this.$confirm('您确定拒绝吗？', '确认拒绝', { type: \"warning\" }).then(() => {\r\n        let data = JSON.parse(JSON.stringify(row));\r\n        data.status = '已拒绝';  // 修改状态为已拒绝\r\n\r\n        this.updateStatus(data);\r\n      }).catch(() => {\r\n        // 取消操作\r\n      });\r\n    },\r\n\r\n    // 更新状态方法\r\n    updateStatus(data) {\r\n      this.$request.put('/user/update', data)\r\n        .then(res => {\r\n          if (res.code === '200') {\r\n            this.$message.success('操作成功');\r\n            this.load(this.pageNum);  // 刷新数据\r\n          } else {\r\n            this.$message.error(res.msg);  // 错误提示\r\n          }\r\n        }).catch(() => {\r\n          this.$message.error('处理失败');\r\n        });\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AA8DA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACA;IACAD,KAAAL,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAO,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAT,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAE,MAAA,OAAAA;QACA;MACA,GAAAO,IAAA,CAAAC,GAAA;QACA,KAAAZ,SAAA,GAAAY,GAAA,CAAAlB,IAAA,EAAAmB,IAAA;QACA,KAAAV,KAAA,GAAAS,GAAA,CAAAlB,IAAA,EAAAS,KAAA;MACA;IACA;IAEA;IACAW,MAAA;MACA,KAAAV,MAAA;MACA,KAAAE,IAAA;IACA;IAEA;IACAS,oBAAAd,OAAA;MACA,KAAAK,IAAA,CAAAL,OAAA;IACA;IAEA;IACAe,YAAAC,GAAA;MACA,KAAAC,QAAA;QAAAC,IAAA;MAAA,GAAAR,IAAA;QACA,IAAAjB,IAAA,GAAAE,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAwB,SAAA,CAAAH,GAAA;QACAvB,IAAA,CAAAU,MAAA;;QAEA,KAAAiB,YAAA,CAAA3B,IAAA;MACA,GAAA4B,KAAA;QACA;MAAA,CACA;IACA;IAEA;IACAC,aAAAN,GAAA;MACA,KAAAC,QAAA;QAAAC,IAAA;MAAA,GAAAR,IAAA;QACA,IAAAjB,IAAA,GAAAE,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAwB,SAAA,CAAAH,GAAA;