{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      content: '',\n      // 发表的内容\n      tableData: [] // 存储帖子数据\n    };\n  },\n\n  created() {\n    this.loadPosts(); // 加载帖子数据\n  },\n\n  methods: {\n    // 加载历史帖子数据\n    loadPosts() {\n      this.$request.get('/fixed/selectAll').then(res => {\n        if (res.code === '200') {\n          this.tableData = res.data.map(item => ({\n            ...item,\n            showReply: false,\n            // 控制回复输入框显示\n            replyContent: '',\n            // 回复内容\n            replies: item.replies || [] // 回复列表\n          }));\n        } else {\n          this.$message.error(res.msg);\n        }\n      }).catch(error => {\n        console.error(\"加载帖子失败:\", error);\n      });\n    },\n    // 提交新的帖子\n    commit() {\n      if (!this.content) {\n        this.$message.error('请输入帖子内容');\n        return;\n      }\n      let data = {\n        content: this.content\n      };\n      this.$request.post('/fixed/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('提交成功，感谢您的发言');\n          this.content = ''; // 清空输入框\n          this.loadPosts(); // 重新加载帖子列表\n        } else {\n          this.$message.error(res.msg);\n        }\n      }).catch(error => {\n        console.error(\"提交帖子失败:\", error);\n      });\n    },\n    // 切换回复输入框显示与否\n    toggleReply(index) {\n      this.tableData[index].showReply = !this.tableData[index].showReply;\n    },\n    // 提交回复\n    submitReply(index) {\n      const replyContent = this.tableData[index].replyContent;\n      if (!replyContent) {\n        this.$message.error('请输入回复内容');\n        return;\n      }\n      const newReply = {\n        content: replyContent\n      };\n\n      // 模拟将回复添加到该帖子的回复列表中\n      this.tableData[index].replies.push(newReply);\n      this.tableData[index].replyContent = ''; // 清空回复内容\n      this.tableData[index].showReply = false; // 隐藏回复框\n      this.$message.success('回复成功');\n\n      // 如果需要，可以将回复同步到服务器\n      // const replyData = {\n      //   postId: this.tableData[index].id,\n      //   replyContent: replyContent\n      // };\n      // this.$request.post('/fixed/reply', replyData).then(res => {\n      //   if (res.code === '200') {\n      //     this.$message.success('回复成功');\n      //   } else {\n      //     this.$message.error(res.msg);\n      //   }\n      // }).catch(error => {\n      //   console.error(\"回复失败:\", error);\n      // });\n    }\n  }\n};","map":{"version":3,"names":["data","content","tableData","created","loadPosts","methods","$request","get","then","res","code","map","item","showReply","replyContent","replies","$message","error","msg","catch","console","commit","post","success","toggleReply","index","submitReply","newReply","push"],"sources":["src/views/front/Fixed.vue"],"sourcesContent":["<template>\r\n    <div style=\"width: 80%; margin: 30px auto\">\r\n        <div style=\"color: #666666; font-size: 16px\">欢迎理性发帖</div>\r\n        <div style=\"margin-top: 20px\">\r\n            <el-input type=\"textarea\" :rows=\"4\" v-model=\"content\" placeholder=\"请输入您的想法\"></el-input>\r\n        </div>\r\n        <div style=\"margin-top: 20px; text-align: right\">\r\n            <el-button style=\"padding: 10px 50px\" type=\"primary\" @click=\"commit\">提交</el-button>\r\n        </div>\r\n\r\n        <div style=\"font-size: 16px; margin-top: 30px; font-weight: bold; color: #666666\">\r\n            历史帖子：{{ tableData.length }}\r\n        </div>\r\n\r\n        <div v-for=\"(item, index) in tableData\" :key=\"item.id\" class=\"post\">\r\n            <div class=\"post-header\">\r\n                <el-image\r\n                        v-if=\"item.avatar\"\r\n                        :src=\"item.avatar\"\r\n                        :preview-src-list=\"[item.avatar]\"\r\n                        style=\"width: 40px; height: 40px; border-radius: 50%; margin-right: 10px\"\r\n                ></el-image>\r\n                <div class=\"post-info\">\r\n                    <div class=\"username\">{{ item.username }}</div>\r\n                    <div class=\"post-time\">{{ item.time }}</div>\r\n                </div>\r\n            </div>\r\n            <div class=\"post-body\">\r\n                <div class=\"post-content\">{{ item.content }}</div>\r\n            </div>\r\n\r\n            <!-- 回复部分 -->\r\n            <div v-if=\"item.showReply\" class=\"reply-section\">\r\n                <el-input type=\"textarea\" :rows=\"2\" v-model=\"item.replyContent\" placeholder=\"输入您的回复\"></el-input>\r\n                <div style=\"margin-top: 10px; text-align: right\">\r\n                    <el-button type=\"primary\" @click=\"submitReply(index)\">回复</el-button>\r\n                </div>\r\n            </div>\r\n            <el-button size=\"small\" @click=\"toggleReply(index)\">回复</el-button>\r\n\r\n            <!-- 显示回复 -->\r\n            <div v-if=\"item.replies && item.replies.length > 0\" class=\"replies\">\r\n                <div v-for=\"(reply, replyIndex) in item.replies\" :key=\"replyIndex\" class=\"reply\">\r\n                    <div class=\"reply-content\">{{ reply.content }}</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      content: '', // 发表的内容\r\n      tableData: [] // 存储帖子数据\r\n    };\r\n  },\r\n  created() {\r\n    this.loadPosts(); // 加载帖子数据\r\n  },\r\n  methods: {\r\n    // 加载历史帖子数据\r\n    loadPosts() {\r\n      this.$request.get('/fixed/selectAll').then(res => {\r\n        if (res.code === '200') {\r\n          this.tableData = res.data.map(item => ({\r\n            ...item,\r\n            showReply: false, // 控制回复输入框显示\r\n            replyContent: '', // 回复内容\r\n            replies: item.replies || [] // 回复列表\r\n          }));\r\n        } else {\r\n          this.$message.error(res.msg);\r\n        }\r\n      }).catch(error => {\r\n        console.error(\"加载帖子失败:\", error);\r\n      });\r\n    },\r\n\r\n    // 提交新的帖子\r\n    commit() {\r\n      if (!this.content) {\r\n        this.$message.error('请输入帖子内容');\r\n        return;\r\n      }\r\n\r\n      let data = {\r\n        content: this.content\r\n      };\r\n\r\n      this.$request.post('/fixed/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('提交成功，感谢您的发言');\r\n          this.content = ''; // 清空输入框\r\n          this.loadPosts(); // 重新加载帖子列表\r\n        } else {\r\n          this.$message.error(res.msg);\r\n        }\r\n      }).catch(error => {\r\n        console.error(\"提交帖子失败:\", error);\r\n      });\r\n    },\r\n\r\n    // 切换回复输入框显示与否\r\n    toggleReply(index) {\r\n      this.tableData[index].showReply = !this.tableData[index].showReply;\r\n    },\r\n\r\n    // 提交回复\r\n    submitReply(index) {\r\n      const replyContent = this.tableData[index].replyContent;\r\n      if (!replyContent) {\r\n        this.$message.error('请输入回复内容');\r\n        return;\r\n      }\r\n\r\n      const newReply = { content: replyContent };\r\n\r\n      // 模拟将回复添加到该帖子的回复列表中\r\n      this.tableData[index].replies.push(newReply);\r\n      this.tableData[index].replyContent = ''; // 清空回复内容\r\n      this.tableData[index].showReply = false; // 隐藏回复框\r\n      this.$message.success('回复成功');\r\n\r\n      // 如果需要，可以将回复同步到服务器\r\n      // const replyData = {\r\n      //   postId: this.tableData[index].id,\r\n      //   replyContent: replyContent\r\n      // };\r\n      // this.$request.post('/fixed/reply', replyData).then(res => {\r\n      //   if (res.code === '200') {\r\n      //     this.$message.success('回复成功');\r\n      //   } else {\r\n      //     this.$message.error(res.msg);\r\n      //   }\r\n      // }).catch(error => {\r\n      //   console.error(\"回复失败:\", error);\r\n      // });\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.post {\r\n  border: 1px solid #e0e0e0;\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #f9f9f9;\r\n  border-radius: 8px;\r\n}\r\n\r\n.post-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.post-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.username {\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #888;\r\n}\r\n\r\n.post-body {\r\n  margin-top: 10px;\r\n}\r\n\r\n.post-content {\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  color: #333;\r\n}\r\n\r\n.reply-section {\r\n  margin-top: 10px;\r\n}\r\n\r\n.replies {\r\n  margin-top: 15px;\r\n}\r\n\r\n.reply {\r\n  margin-bottom: 8px;\r\n  padding: 5px;\r\n  background-color: #f1f1f1;\r\n  border-radius: 5px;\r\n}\r\n\r\n.reply-content {\r\n  font-size: 14px;\r\n  color: #555;\r\n}\r\n</style>\r\n"],"mappings":";AAmDA;EACAA,KAAA;IACA;MACAC,OAAA;MAAA;MACAC,SAAA;IACA;EACA;;EACAC,QAAA;IACA,KAAAC,SAAA;EACA;;EACAC,OAAA;IACA;IACAD,UAAA;MACA,KAAAE,QAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAR,SAAA,GAAAO,GAAA,CAAAT,IAAA,CAAAW,GAAA,CAAAC,IAAA;YACA,GAAAA,IAAA;YACAC,SAAA;YAAA;YACAC,YAAA;YAAA;YACAC,OAAA,EAAAH,IAAA,CAAAG,OAAA;UACA;QACA;UACA,KAAAC,QAAA,CAAAC,KAAA,CAAAR,GAAA,CAAAS,GAAA;QACA;MACA,GAAAC,KAAA,CAAAF,KAAA;QACAG,OAAA,CAAAH,KAAA,YAAAA,KAAA;MACA;IACA;IAEA;IACAI,OAAA;MACA,UAAApB,OAAA;QACA,KAAAe,QAAA,CAAAC,KAAA;QACA;MACA;MAEA,IAAAjB,IAAA;QACAC,OAAA,OAAAA;MACA;MAEA,KAAAK,QAAA,CAAAgB,IAAA,eAAAtB,IAAA,EAAAQ,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAM,QAAA,CAAAO,OAAA;UACA,KAAAtB,OAAA;UACA,KAAAG,SAAA;QACA;UACA,KAAAY,QAAA,CAAAC,KAAA,CAAAR,GAAA,CAAAS,GAAA;QACA;MACA,GAAAC,KAAA,CAAAF,KAAA;QACAG,OAAA,CAAAH,KAAA,YAAAA,KAAA;MACA;IACA;IAEA;IACAO,YAAAC,KAAA;MACA,KAAAvB,SAAA,CAAAuB,KAAA,EAAAZ,SAAA,SAAAX,SAAA,CAAAuB,KAAA,EAAAZ,SAAA;IACA;IAEA;IACAa,YAAAD,KAAA;MACA,MAAAX,YAAA,QAAAZ,SAAA,CAAAuB,KAAA,EAAAX,YAAA;MACA,KAAAA,YAAA;QACA,KAAAE,QAAA,CAAAC,KAAA;QACA;MACA;MAEA,MAAAU,QAAA;QAAA1B,OAAA,EAAAa;MAAA;;MAEA;MACA,KAAAZ,SAAA,CAAAuB,KAAA,EAAAV,OAAA,CAAAa,IAAA,CAAAD,QAAA;MACA,KAAAzB