{"ast":null,"code":"export default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      content: null,\n      tableData: []\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    load() {\n      this.$request.get('/fixed/selectAll').then(res => {\n        if (res.code === '200') {\n          this.tableData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    commit() {\n      let data = {\n        content: this.content\n      };\n      this.$request.post('/fixed/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('提交成功，感谢您的发言');\n          this.content = null;\n          this.load();\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","user","JSON","parse","localStorage","getItem","content","tableData","created","load","methods","$request","get","then","res","code","$message","error","msg","commit","post","success"],"sources":["src/views/front/Fixed.vue"],"sourcesContent":["<template>\r\n    <div style=\"width: 80%; margin: 30px auto\">\r\n        <div style=\"color: #666666; font-size: 16px\">欢迎理性发帖</div>\r\n        <div style=\"margin-top: 20px\">\r\n            <el-input type=\"textarea\" :rows=\"4\" v-model=\"content\" placeholder=\"请输入您的想法\"></el-input>\r\n        </div>\r\n        <div style=\"margin-top: 20px; text-align: right\">\r\n            <el-button style=\"padding: 10px 50px\" type=\"primary\" @click=\"commit\">提交</el-button>\r\n        </div>\r\n\r\n        <div style=\"font-size: 16px; margin-top: 30px; font-weight: bold; color: #666666\">\r\n            历史帖子：{{ tableData.length }}\r\n        </div>\r\n\r\n        <div v-for=\"(item, index) in tableData\" :key=\"index\" class=\"post\">\r\n            <div class=\"post-header\">\r\n                <el-image\r\n                        v-if=\"item.avatar\"\r\n                        :src=\"item.avatar\"\r\n                        :preview-src-list=\"[item.avatar]\"\r\n                        style=\"width: 40px; height: 40px; border-radius: 50%; margin-right: 10px\">\r\n                </el-image>\r\n                <div class=\"post-info\">\r\n                    <div class=\"username\">{{ item.username }}</div>\r\n                    <div class=\"post-time\">{{ item.time }}</div>\r\n                </div>\r\n            </div>\r\n            <div class=\"post-body\">\r\n                <div class=\"post-content\">{{ item.content }}</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      content: null,\r\n      tableData: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n  },\r\n  methods: {\r\n    load() {\r\n\r\n      this.$request.get('/fixed/selectAll').then(res => {\r\n\r\n        if (res.code === '200') {\r\n\r\n          this.tableData = res.data\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    commit() {\r\n      let data = {\r\n        content: this.content\r\n      }\r\n      this.$request.post('/fixed/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('提交成功，感谢您的发言')\r\n          this.content = null\r\n          this.load()\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.post {\r\n  border: 1px solid #e0e0e0;\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #f9f9f9;\r\n  border-radius: 8px;\r\n}\r\n\r\n.post-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.post-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.username {\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #888;\r\n}\r\n\r\n.post-body {\r\n  margin-top: 10px;\r\n}\r\n\r\n.post-content {\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  color: #333;\r\n}\r\n</style>\r\n"],"mappings":"AAoCA;EACAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAA;MAEA,KAAAE,QAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;QAEA,IAAAA,GAAA,CAAAC,IAAA;UAEA,KAAAR,SAAA,GAAAO,GAAA,CAAAd,IAAA;QACA;UACA,KAAAgB,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;IACAC,OAAA;MACA,IAAAnB,IAAA;QACAM,OAAA,OAAAA;MACA;MACA,KAAAK,QAAA,CAAAS,IAAA,eAAApB,IAAA,EAAAa,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAK,OAAA;UACA,KAAAf,OAAA;UACA,KAAAG,IAAA;QACA;UACA,KAAAO,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}