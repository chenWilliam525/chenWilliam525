{"ast":null,"code":"export default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      content: null,\n      tableData: []\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    load() {\n      this.$request.get('/fixed/selectAll').then(res => {\n        if (res.code === '200') {\n          console.log(tableData);\n          this.tableData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    commit() {\n      let data = {\n        content: this.content\n      };\n      this.$request.post('/fixed/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('提交成功，感谢您的发言');\n          this.content = null;\n          this.load();\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","user","JSON","parse","localStorage","getItem","content","tableData","created","load","methods","$request","get","then","res","code","console","log","$message","error","msg","commit","post","success"],"sources":["src/views/front/Fixed.vue"],"sourcesContent":["<template>\r\n  <div style=\"width: 50%; margin: 30px auto\">\r\n    <div style=\"color: #666666; font-size: 16px\">欢迎理性发帖</div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-input type=\"textarea\" :rows=\"4\" v-model=\"content\" placeholder=\"请输入您的想法\"></el-input>\r\n    </div>\r\n    <div style=\"margin-top: 20px; text-align: right\">\r\n      <el-button style=\"padding: 10px 50px\" type=\"primary\" @click=\"commit\">提交</el-button>\r\n    </div>\r\n    <div style=\"font-size: 16px; margin-top: 30px; font-weight: bold; color: #666666\">\r\n      历史帖子：{{ tableData.length }}\r\n    </div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"content\" label=\"发帖内容\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"time\" label=\"发帖时间\" width=\"150px\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"业主姓名\" width=\"100px\"></el-table-column>\r\n        <el-table-column prop=\"username\" label=\"账号\" width=\"100px\"></el-table-column>\r\n        <el-table-column prop=\"number\" label=\"文章编号\" width=\"100px\"></el-table-column>\r\n      </el-table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      content: null,\r\n      tableData: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n  },\r\n  methods: {\r\n    load() {\r\n\r\n      this.$request.get('/fixed/selectAll').then(res => {\r\n\r\n        if (res.code === '200') {\r\n          console.log(tableData);\r\n          this.tableData = res.data\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    commit() {\r\n      let data = {\r\n        content: this.content\r\n      }\r\n      this.$request.post('/fixed/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('提交成功，感谢您的发言')\r\n          this.content = null\r\n          this.load()\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>\r\n"],"mappings":"AAyBA;EACAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAA;MAEA,KAAAE,QAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;QAEA,IAAAA,GAAA,CAAAC,IAAA;UACAC,OAAA,CAAAC,GAAA,CAAAV,SAAA;UACA,KAAAA,SAAA,GAAAO,GAAA,CAAAd,IAAA;QACA;UACA,KAAAkB,QAAA,CAAAC,KAAA,CAAAL,GAAA,CAAAM,GAAA;QACA;MACA;IACA;IACAC,OAAA;MACA,IAAArB,IAAA;QACAM,OAAA,OAAAA;MACA;MACA,KAAAK,QAAA,CAAAW,IAAA,eAAAtB,IAAA,EAAAa,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAG,QAAA,CAAAK,OAAA;UACA,KA