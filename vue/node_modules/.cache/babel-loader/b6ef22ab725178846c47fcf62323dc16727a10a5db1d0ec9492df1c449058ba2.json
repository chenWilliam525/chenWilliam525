{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      content: null,\n      tableData: []\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    load() {\n      this.$request.get('/fixed/selectAll').then(res => {\n        if (res.code === '200') {\n          // 假设返回的数据中每个帖子有 replies 数组存储评论\n          this.tableData = res.data.map(item => ({\n            ...item,\n            replies: item.replies || [],\n            // 确保帖子有评论数据\n            replyContent: '' // 回复输入框内容\n          }));\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    commit() {\n      let data = {\n        content: this.content\n      };\n      this.$request.post('/fixed/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('提交成功，感谢您的发言');\n          this.content = null;\n          this.load(); // 刷新列表\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    submitReply(post) {\n      if (!post.replyContent) {\n        this.$message.error('回复内容不能为空');\n        return;\n      }\n      let replyData = {\n        content: post.replyContent,\n        username: this.user.username,\n        time: new Date().toLocaleString()\n      };\n\n      // 假设这里提交的接口是 `/fixed/reply`，并且接受一个包含帖子id和回复数据的请求体\n      this.$request.post('/fixed/reply', {\n        postId: post.id,\n        reply: replyData\n      }).then(res => {\n        if (res.code === '200') {\n          this.$message.success('回复成功');\n          post.replies.push(replyData); // 新增回复到当前帖子\n          post.replyContent = ''; // 清空输入框\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","user","JSON","parse","localStorage","getItem","content","tableData","created","load","methods","$request","get","then","res","code","map","item","replies","replyContent","$message","error","msg","commit","post","success","submitReply","replyData","username","time","Date","toLocaleString","postId","id","reply","push"],"sources":["src/views/front/Fixed.vue"],"sourcesContent":["<template>\r\n    <div style=\"width: 80%; margin: 30px auto\">\r\n        <div style=\"color: #666666; font-size: 16px\">欢迎理性发帖</div>\r\n        <div style=\"margin-top: 20px\">\r\n            <el-input type=\"textarea\" :rows=\"4\" v-model=\"content\" placeholder=\"请输入您的想法\"></el-input>\r\n        </div>\r\n        <div style=\"margin-top: 20px; text-align: right\">\r\n            <el-button style=\"padding: 10px 50px\" type=\"primary\" @click=\"commit\">提交</el-button>\r\n        </div>\r\n\r\n        <div style=\"font-size: 16px; margin-top: 30px; font-weight: bold; color: #666666\">\r\n            历史帖子：{{ tableData.length }}\r\n        </div>\r\n\r\n        <div v-for=\"(item, index) in tableData\" :key=\"index\" class=\"post\">\r\n            <div class=\"post-header\">\r\n                <el-image\r\n                        v-if=\"item.avatar\"\r\n                        :src=\"item.avatar\"\r\n                        :preview-src-list=\"[item.avatar]\"\r\n                        style=\"width: 40px; height: 40px; border-radius: 50%; margin-right: 10px\">\r\n                </el-image>\r\n                <div class=\"post-info\">\r\n                    <div class=\"username\">{{ item.username }}</div>\r\n                    <div class=\"post-time\">{{ item.time }}</div>\r\n                </div>\r\n            </div>\r\n            <div class=\"post-body\">\r\n                <div class=\"post-content\">{{ item.content }}</div>\r\n            </div>\r\n\r\n            <!-- 显示评论 -->\r\n            <div v-if=\"item.replies && item.replies.length > 0\" class=\"post-replies\">\r\n                <div v-for=\"(reply, index) in item.replies\" :key=\"index\" class=\"reply\">\r\n                    <div class=\"reply-header\">\r\n                        <div class=\"reply-username\">{{ reply.username }}</div>\r\n                        <div class=\"reply-time\">{{ reply.time }}</div>\r\n                    </div>\r\n                    <div class=\"reply-body\">\r\n                        <div class=\"reply-content\">{{ reply.content }}</div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- 评论输入框 -->\r\n            <div class=\"reply-input\">\r\n                <el-input\r\n                        type=\"textarea\"\r\n                        :rows=\"3\"\r\n                        v-model=\"item.replyContent\"\r\n                        placeholder=\"请输入回复内容\"\r\n                        style=\"margin-top: 10px;\">\r\n                </el-input>\r\n                <el-button @click=\"submitReply(item)\" type=\"primary\" style=\"margin-top: 10px;\">提交回复</el-button>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      content: null,\r\n      tableData: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n  },\r\n  methods: {\r\n    load() {\r\n      this.$request.get('/fixed/selectAll').then(res => {\r\n        if (res.code === '200') {\r\n          // 假设返回的数据中每个帖子有 replies 数组存储评论\r\n          this.tableData = res.data.map(item => ({\r\n            ...item,\r\n            replies: item.replies || [], // 确保帖子有评论数据\r\n            replyContent: '', // 回复输入框内容\r\n          }));\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    commit() {\r\n      let data = {\r\n        content: this.content\r\n      }\r\n      this.$request.post('/fixed/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('提交成功，感谢您的发言')\r\n          this.content = null\r\n          this.load() // 刷新列表\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    submitReply(post) {\r\n      if (!post.replyContent) {\r\n        this.$message.error('回复内容不能为空')\r\n        return\r\n      }\r\n\r\n      let replyData = {\r\n        content: post.replyContent,\r\n        username: this.user.username,\r\n        time: new Date().toLocaleString(),\r\n      }\r\n\r\n      // 假设这里提交的接口是 `/fixed/reply`，并且接受一个包含帖子id和回复数据的请求体\r\n      this.$request.post('/fixed/reply', { postId: post.id, reply: replyData }).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('回复成功')\r\n          post.replies.push(replyData) // 新增回复到当前帖子\r\n          post.replyContent = '' // 清空输入框\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.post {\r\n  border: 1px solid #e0e0e0;\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #f9f9f9;\r\n  border-radius: 8px;\r\n}\r\n\r\n.post-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.post-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.username {\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #888;\r\n}\r\n\r\n.post-body {\r\n  margin-top: 10px;\r\n}\r\n\r\n.post-content {\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  color: #333;\r\n}\r\n\r\n.post-replies {\r\n  margin-top: 20px;\r\n}\r\n\r\n.reply {\r\n  border: 1px solid #e0e0e0;\r\n  padding: 10px;\r\n  background-color: #f1f1f1;\r\n  margin-top: 10px;\r\n  border-radius: 6px;\r\n}\r\n\r\n.reply-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n}\r\n\r\n.reply-username {\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n\r\n.reply-time {\r\n  font-size: 12px;\r\n  color: #888;\r\n}\r\n\r\n.reply-body {\r\n  margin-top: 5px;\r\n}\r\n\r\n.reply-content {\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  color: #333;\r\n}\r\n\r\n.reply-input {\r\n  margin-top: 15px;\r\n}\r\n</style>\r\n"],"mappings":";AA4DA;EACAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAA;MACA,KAAAE,QAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA;UACA,KAAAR,SAAA,GAAAO,GAAA,CAAAd,IAAA,CAAAgB,GAAA,CAAAC,IAAA;YACA,GAAAA,IAAA;YACAC,OAAA,EAAAD,IAAA,CAAAC,OAAA;YAAA;YACAC,YAAA;UACA;QACA;UACA,KAAAC,QAAA,CAAAC,KAAA,CAAAP,GAAA,CAAAQ,GAAA;QACA;MACA;IACA;IACAC,OAAA;MACA,IAAAvB,IAAA;QACAM,OAAA,OAAAA;MACA;MACA,KAAAK,QAAA,CAAAa,IAAA,eAAAxB,IAAA,EAAAa,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAK,QAAA,CAAAK,OAAA;UACA,KAAAnB,OAAA;UACA,KAAAG,IAAA;QACA;UACA,KAAAW,QAAA,CAAAC,KAAA,CAAAP,GAAA,CAAAQ,GAAA;QACA;MACA;IACA;IACAI,YAAAF,IAAA;MACA,KAAAA,IAAA,CAAAL,YAAA;QACA,KAAAC,QAAA,CAAAC,KAAA;QACA;MACA;MAEA,IAAAM,SAAA;QACArB,OAAA,EAAAkB,IAAA,CAAAL,YAAA;QACAS,QAAA,OAAA3B,IAAA,CAAA2B,QAAA;QACAC,IAAA,MAAAC,IAAA,GAAAC,cAAA;MACA;;MAEA;MACA,KAAApB,QAAA,CAAAa,IAAA;QAAAQ,MAAA,EAAAR,IAAA,CAAAS,EAAA;QAAAC,KAAA,EAAAP;MAAA,GAAAd,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAK,QAAA,CAAAK,OAAA;UACAD,IAAA,CAAAN,OAAA,CAAAiB,IAAA,CAAAR,SAAA;UACAH,IAAA,CAAAL,YAAA;QACA;UACA,KAAAC,QAAA,CAAAC,KAAA,CAAAP,GAAA,CAAAQ,GAAA;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}