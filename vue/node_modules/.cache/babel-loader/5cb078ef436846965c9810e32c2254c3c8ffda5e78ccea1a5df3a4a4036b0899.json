{"ast":null,"code":"export default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      content: null,\n      tableData: []\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    load() {\n      this.$request.get('/complaint/selectAll').then(res => {\n        if (res.code === '200') {\n          this.tableData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    commit() {\n      let data = {\n        content: this.content\n      };\n      this.$request.post('/complaint/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('反馈成功，我们会认真考虑您反馈的信息');\n          this.content = null;\n          this.load();\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","user","JSON","parse","localStorage","getItem","content","tableData","created","load","methods","$request","get","then","res","code","$message","error","msg","commit","post","success"],"sources":["src/views/front/Complaint.vue"],"sourcesContent":["\r\n<template>\r\n  <div style=\"width: 50%; margin: 30px auto\">\r\n    <div style=\"color: #666666; font-size: 16px\">欢迎发表您宝贵的意见，我们会认真考虑</div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-input type=\"textarea\" :rows=\"4\" v-model=\"content\" placeholder=\"请输入您的投诉或者建议\"></el-input>\r\n    </div>\r\n    <div style=\"margin-top: 20px; text-align: right\">\r\n      <el-button style=\"padding: 10px 50px\" type=\"primary\" @click=\"commit\">提交</el-button>\r\n    </div>\r\n    <div style=\"font-size: 16px; margin-top: 30px; font-weight: bold; color: #666666\">\r\n      历史反馈的问题：{{ tableData.length }}\r\n    </div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"content\" label=\"反馈内容\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"time\" label=\"提交时间\" width=\"150px\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"id\" label=\"业主姓名\" width=\"100px\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"处理状态\" width=\"100px\">\r\n          <template v-slot=\"scope\">\r\n            <el-tag type=\"success\" v-if=\"scope.row.status === '已处理'\">已处理</el-tag>\r\n            <el-tag type=\"danger\" v-else>待处理</el-tag>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      content: null,\r\n      tableData: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n  },\r\n  methods: {\r\n    load() {\r\n      this.$request.get('/complaint/selectAll').then(res => {\r\n        if (res.code === '200') {\r\n          this.tableData = res.data\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    commit() {\r\n      let data = {\r\n        content: this.content\r\n      }\r\n      this.$request.post('/complaint/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('反馈成功，我们会认真考虑您反馈的信息')\r\n          this.content = null\r\n          this.load()\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>\r\n\r\n"],"mappings":"AA8BA;EACAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAA;MACA,KAAAE,QAAA,CAAAC,GAAA,yBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAR,SAAA,GAAAO,GAAA,CAAAd,IAAA;QACA;UACA,KAAAgB,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;IACAC,OAAA;MACA,IAAAnB,IAAA;QACAM,OAAA,OAAAA;MACA;MACA,KAAAK,QAAA,CAAAS,IAAA,mBAAApB,IAAA,EAAAa,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAK,OAAA;UACA,KAAAf,OAAA;UACA,KAAAG,IAAA;QACA;UACA,KAAAO,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}