{"ast":null,"code":"export default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      content: null,\n      tableData: []\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    load() {\n      this.$request.get('/fixed/selectAll').then(res => {\n        if (res.code === '200') {\n          this.tableData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    commit() {\n      let data = {\n        content: this.content\n      };\n      this.$request.post('/fixed/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('提交成功，感谢您的发言');\n          this.content = null;\n          this.load();\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","user","JSON","parse","localStorage","getItem","content","tableData","created","load","methods","$request","get","then","res","code","$message","error","msg","commit","post","success"],"sources":["src/views/front/Activity.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"card\" style=\"padding: 15px\">\r\n      您好，{{ user?.name }}！欢迎使用本系统\r\n    </div>\r\n\r\n    <div style=\"display: flex; margin: 10px 0\">\r\n      <div style=\"width: 50%;\" class=\"card\">\r\n        <div style=\"margin-bottom: 30px; font-size: 20px; font-weight: bold\">公告列表</div>\r\n        <div >\r\n          <el-timeline  reverse slot=\"reference\">\r\n            <el-timeline-item v-for=\"item in notices\" :key=\"item.id\" :timestamp=\"item.time\">\r\n              <el-popover\r\n                      placement=\"right\"\r\n                      width=\"200\"\r\n                      trigger=\"hover\"\r\n                      :content=\"item.content\">\r\n                <span slot=\"reference\">{{ item.title }}</span>\r\n              </el-popover>\r\n            </el-timeline-item>\r\n          </el-timeline>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      content: null,\r\n      tableData: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n  },\r\n  methods: {\r\n    load() {\r\n      this.$request.get('/fixed/selectAll').then(res => {\r\n        if (res.code === '200') {\r\n          this.tableData = res.data\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    commit() {\r\n      let data = {\r\n        content: this.content\r\n      }\r\n      this.$request.post('/fixed/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('提交成功，感谢您的发言')\r\n          this.content = null\r\n          this.load()\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>\r\n"],"mappings":"AA4BA;EACAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAA;MACA,KAAAE,QAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAR,SAAA,GAAAO,GAAA,CAAAd,IAAA;QACA;UACA,KAAAgB,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;IACAC,OAAA;MACA,IAAAnB,IAAA;QACAM,OAAA,OAAAA;MACA;MACA,KAAAK,QAAA,CAAAS,IAAA,eAAApB,IAAA,EAAAa,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAK,OAAA;UACA,KAAAf,OAAA;UACA,KAAAG,IAAA;QACA;UACA,KAAAO,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}