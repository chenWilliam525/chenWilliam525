{"ast":null,"code":"export default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      content: null,\n      tableData: []\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    load(pageNum) {\n      // 分页查询\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/complaint/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          status: this.status,\n          name: this.name\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.status = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    },\n    handleComplaint(row) {\n      let data = JSON.parse(JSON.stringify(row));\n      data.status = '已处理';\n      this.$request.put('/complaint/update', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('处理成功');\n          this.load(this.pageNum);\n        }\n      });\n    },\n    commit() {\n      let data = {\n        content: this.content\n      };\n      this.$request.post('/complaint/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('反馈成功，我们会认真考虑您反馈的信息');\n          this.content = null;\n          this.load();\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","user","JSON","parse","localStorage","getItem","content","tableData","created","load","methods","pageNum","$request","get","params","pageSize","status","name","then","res","list","total","reset","handleCurrentChange","handleComplaint","row","stringify","put","code","$message","success","commit","post","error","msg"],"sources":["src/views/front/Complaint.vue"],"sourcesContent":["\r\n<template>\r\n  <div style=\"width: 50%; margin: 30px auto\">\r\n    <div style=\"color: #666666; font-size: 16px\">欢迎发表您宝贵的意见，我们会认真考虑</div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-input type=\"textarea\" :rows=\"4\" v-model=\"content\" placeholder=\"请输入您的投诉或者建议\"></el-input>\r\n    </div>\r\n    <div style=\"margin-top: 20px; text-align: right\">\r\n      <el-button style=\"padding: 10px 50px\" type=\"primary\" @click=\"commit\">提交</el-button>\r\n    </div>\r\n    <div style=\"font-size: 16px; margin-top: 30px; font-weight: bold; color: #666666\">\r\n      历史反馈的问题：{{ tableData.length }}\r\n    </div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"content\" label=\"反馈内容\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"time\" label=\"提交时间\" width=\"150px\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"业主姓名\" width=\"100px\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"处理状态\" width=\"100px\">\r\n          <template v-slot=\"scope\">\r\n            <el-tag type=\"success\" v-if=\"scope.row.status === '已处理'\">已处理</el-tag>\r\n            <el-tag type=\"danger\" v-else>待处理</el-tag>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      content: null,\r\n      tableData: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n  },\r\n  methods: {\r\n\r\n    load(pageNum) {  // 分页查询\r\n      if (pageNum) this.pageNum = pageNum\r\n      this.$request.get('/complaint/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          status: this.status,\r\n          name:this.name\r\n\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data?.list\r\n        this.total = res.data?.total\r\n      })\r\n    },\r\n    reset() {\r\n      this.status = null\r\n      this.load(1)\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum)\r\n    },\r\n    handleComplaint(row) {\r\n      let data = JSON.parse(JSON.stringify(row))\r\n      data.status = '已处理'\r\n      this.$request.put('/complaint/update', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('处理成功')\r\n          this.load(this.pageNum)\r\n        }\r\n      })\r\n    },\r\n    commit() {\r\n      let data = {\r\n        content: this.content\r\n      }\r\n      this.$request.post('/complaint/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('反馈成功，我们会认真考虑您反馈的信息')\r\n          this.content = null\r\n          this.load()\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>\r\n\r\n"],"mappings":"AA8BA;EACAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IAEAD,KAAAE,OAAA;MAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAC,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAH,OAAA,OAAAA,OAAA;UACAI,QAAA,OAAAA,QAAA;UACAC,MAAA,OAAAA,MAAA;UACAC,IAAA,OAAAA;QAEA;MACA,GAAAC,IAAA,CAAAC,GAAA;QACA,KAAAZ,SAAA,GAAAY,GAAA,CAAAnB,IAAA,EAAAoB,IAAA;QACA,KAAAC,KAAA,GAAAF,GAAA,CAAAnB,IAAA,EAAAqB,KAAA;MACA;IACA;IACAC,MAAA;MACA,KAAAN,MAAA;MACA,KAAAP,IAAA;IACA;IACAc,oBAAAZ,OAAA;MACA,KAAAF,IAAA,CAAAE,OAAA;IACA;IACAa,gBAAAC,GAAA;MACA,IAAAzB,IAAA,GAAAE,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAwB,SAAA,CAAAD,GAAA;MACAzB,IAAA,CAAAgB,MAAA;MACA,KAAAJ,QAAA,CAAAe,GAAA,sBAAA3B,IAAA,EAAAkB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAS,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAArB,IAAA,MAAAE,OAAA;QACA;MACA;IACA;IACAoB,OAAA;MACA,IAAA/B,IAAA;QACAM,OAAA,OAAAA;MACA;MACA,KAAAM,QAAA,CAAAoB,IAAA,mBAAAhC,IAAA,EAAAkB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAS,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;