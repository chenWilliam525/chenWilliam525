{"ast":null,"code":"import { toRaw } from 'vue';\nexport default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      content: null,\n      tableData: []\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    load() {\n      this.$request.get('/fixed/selectAll').then(res => {\n        if (res.code === '200') {\n          // 打印整个返回的 data 数据\n          console.log('完整的返回数据:', res.data);\n\n          // 确保访问并打印每一项的字段\n          res.data.forEach(item => {\n            console.log('帖子内容:', item.content);\n            console.log('时间:', item.time);\n            console.log('用户名:', item.username); // 检查是否有这个字段\n            console.log('编号:', item.number); // 检查是否有这个字段\n          });\n\n          // 更新 tableData\n          this.tableData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      }).catch(error => {\n        console.error('加载数据失败', error);\n        this.$message.error('加载数据失败');\n      });\n    },\n    commit() {\n      let data = {\n        content: this.content\n      };\n      this.$request.post('/fixed/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('提交成功，感谢您的发言');\n          this.content = null;\n          this.load();\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["toRaw","data","user","JSON","parse","localStorage","getItem","content","tableData","created","load","methods","$request","get","then","res","code","console","log","forEach","item","time","username","number","$message","error","msg","catch","commit","post","success"],"sources":["src/views/front/Fixed.vue"],"sourcesContent":["\r\n<template>\r\n  <div style=\"width: 50%; margin: 30px auto\">\r\n    <div style=\"color: #666666; font-size: 16px\">欢迎理性发帖</div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-input type=\"textarea\" :rows=\"4\" v-model=\"content\" placeholder=\"请输入您的想法\"></el-input>\r\n    </div>\r\n    <div style=\"margin-top: 20px; text-align: right\">\r\n      <el-button style=\"padding: 10px 50px\" type=\"primary\" @click=\"commit\">提交</el-button>\r\n    </div>\r\n    <div style=\"font-size: 16px; margin-top: 30px; font-weight: bold; color: #666666\">\r\n      历史帖子：{{ tableData.length }}\r\n    </div>\r\n    <div style=\"margin-top: 20px\">\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"content\" label=\"发帖内容\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"time\" label=\"发帖时间\" width=\"150px\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"业主姓名\" width=\"100px\"></el-table-column>\r\n        <el-table-column prop=\"username\" label=\"账号\" width=\"100px\"></el-table-column>\r\n        <el-table-column prop=\"number\" label=\"文章编号\" width=\"100px\"></el-table-column>\r\n      </el-table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { toRaw } from 'vue';\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      content: null,\r\n      tableData: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n  },\r\n  methods: {\r\nload() {\r\n  this.$request.get('/fixed/selectAll').then(res => {\r\n    if (res.code === '200') {\r\n      // 打印整个返回的 data 数据\r\n      console.log('完整的返回数据:', res.data);\r\n\r\n      // 确保访问并打印每一项的字段\r\n      res.data.forEach(item => {\r\n        console.log('帖子内容:', item.content);\r\n        console.log('时间:', item.time);\r\n        console.log('用户名:', item.username);  // 检查是否有这个字段\r\n        console.log('编号:', item.number);      // 检查是否有这个字段\r\n      });\r\n\r\n      // 更新 tableData\r\n      this.tableData = res.data;\r\n    } else {\r\n      this.$message.error(res.msg);\r\n    }\r\n  }).catch(error => {\r\n    console.error('加载数据失败', error);\r\n    this.$message.error('加载数据失败');\r\n  });\r\n}\r\n,\r\n    commit() {\r\n      let data = {\r\n        content: this.content\r\n      }\r\n      this.$request.post('/fixed/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('提交成功，感谢您的发言')\r\n          this.content = null\r\n          this.load()\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>\r\n"],"mappings":"AA0BA,SAAAA,KAAA;AACA;EACAC,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAA;MACA,KAAAE,QAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA;UACAC,OAAA,CAAAC,GAAA,aAAAH,GAAA,CAAAd,IAAA;;UAEA;UACAc,GAAA,CAAAd,IAAA,CAAAkB,OAAA,CAAAC,IAAA;YACAH,OAAA,CAAAC,GAAA,UAAAE,IAAA,CAAAb,OAAA;YACAU,OAAA,CAAAC,GAAA,QAAAE,IAAA,CAAAC,IAAA;YACAJ,OAAA,CAAAC,GAAA,SAAAE,IAAA,CAAAE,QAAA;YACAL,OAAA,CAAAC,GAAA,QAAAE,IAAA,CAAAG,MAAA;UACA;;UAEA;UACA,KAAAf,SAAA,GAAAO,GAAA,CAAAd,IAAA;QACA;UACA,KAAAuB,QAAA,CAAAC,KAAA,CAAAV,GAAA,CAAAW,GAAA;QACA;MACA,GAAAC,KAAA,CAAAF,KAAA;QACAR,OAAA,CAAAQ,KAAA,WAAAA,KAAA;QACA,KAAAD,QAAA,CAAAC,KAAA;MACA;IACA;IAEAG,OAAA;MACA,IAAA3B,IAAA;QACAM,OAAA,OAAAA;MACA;MACA,KAAAK,QAAA,CAAAiB,IAAA,eAAA5B,IAAA,EAAAa,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAQ,QAAA,CAAAM,OAAA;UACA,KAAAvB,OAAA;UACA,KAAAG,IAAA;QACA;UACA,KAAAc,QAAA,CAAAC,KAAA,CAAAV,GAAA,CAAAW,GAAA;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}