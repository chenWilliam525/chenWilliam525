{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      content: null,\n      tableData: []\n    };\n  },\n  created() {\n    this.load();\n  },\n  methods: {\n    load() {\n      this.$request.get('/fixed/selectAll').then(res => {\n        if (res.code === '200') {\n          // 初始化每个帖子时，加入 showReply 和 replies\n          this.tableData = res.data.map(item => ({\n            ...item,\n            showReply: false,\n            replyContent: '',\n            replies: item.replies || [] // 确保每个帖子都有一个回复数组\n          }));\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    commit() {\n      let data = {\n        content: this.content\n      };\n      this.$request.post('/fixed/add', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('提交成功，感谢您的发言');\n          this.content = null;\n          this.load();\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    toggleReply(index) {\n      // 切换显示回复输入框\n      this.tableData[index].showReply = !this.tableData[index].showReply;\n    },\n    submitReply(index) {\n      if (!this.tableData[index].replyContent) {\n        this.$message.error('请输入回复内容');\n        return;\n      }\n      // 模拟提交回复的请求\n      this.$request.post('/fixed/reply', {\n        postId: this.tableData[index].id,\n        replyContent: this.tableData[index].replyContent\n      }).then(res => {\n        if (res.code === '200') {\n          // 将回复内容加入回复列表\n          this.tableData[index].replies.push(this.tableData[index].replyContent);\n          this.tableData[index].replyContent = '';\n          this.tableData[index].showReply = false;\n          this.$message.success('回复成功');\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","user","JSON","parse","localStorage","getItem","content","tableData","created","load","methods","$request","get","then","res","code","map","item","showReply","replyContent","replies","$message","error","msg","commit","post","success","toggleReply","index","submitReply","postId","id","push"],"sources":["src/views/front/Fixed.vue"],"sourcesContent":["<template>\r\n    <div style=\"width: 80%; margin: 30px auto\">\r\n        <div style=\"color: #666666; font-size: 16px\">欢迎理性发帖</div>\r\n        <div style=\"margin-top: 20px\">\r\n            <el-input type=\"textarea\" :rows=\"4\" v-model=\"content\" placeholder=\"请输入您的想法\"></el-input>\r\n        </div>\r\n        <div style=\"margin-top: 20px; text-align: right\">\r\n            <el-button style=\"padding: 10px 50px\" type=\"primary\" @click=\"commit\">提交</el-button>\r\n        </div>\r\n\r\n        <div style=\"font-size: 16px; margin-top: 30px; font-weight: bold; color: #666666\">\r\n            历史帖子：{{ tableData.length }}\r\n        </div>\r\n\r\n        <div v-for=\"(item, index) in tableData\" :key=\"index\" class=\"post\">\r\n            <div class=\"post-header\">\r\n                <el-image\r\n                        v-if=\"item.avatar\"\r\n                        :src=\"item.avatar\"\r\n                        :preview-src-list=\"[item.avatar]\"\r\n                        style=\"width: 40px; height: 40px; border-radius: 50%; margin-right: 10px\"\r\n                ></el-image>\r\n                <div class=\"post-info\">\r\n                    <div class=\"username\">{{ item.username }}</div>\r\n                    <div class=\"post-time\">{{ item.time }}</div>\r\n                </div>\r\n            </div>\r\n            <div class=\"post-body\">\r\n                <div class=\"post-content\">{{ item.content }}</div>\r\n            </div>\r\n\r\n            <!-- 回复部分 -->\r\n            <div v-if=\"item.showReply\" class=\"reply-section\">\r\n                <el-input type=\"textarea\" :rows=\"2\" v-model=\"item.replyContent\" placeholder=\"输入您的回复\"></el-input>\r\n                <div style=\"margin-top: 10px; text-align: right\">\r\n                    <el-button type=\"primary\" @click=\"submitReply(index)\">回复</el-button>\r\n                </div>\r\n            </div>\r\n            <el-button size=\"small\" @click=\"toggleReply(index)\">回复</el-button>\r\n\r\n            <!-- 显示回复 -->\r\n            <div v-if=\"item.replies && item.replies.length > 0\" class=\"replies\">\r\n                <div v-for=\"(reply, replyIndex) in item.replies\" :key=\"replyIndex\" class=\"reply\">\r\n                    <div class=\"reply-content\">{{ reply }}</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      content: null,\r\n      tableData: []\r\n    }\r\n  },\r\n  created() {\r\n    this.load()\r\n  },\r\n  methods: {\r\n    load() {\r\n      this.$request.get('/fixed/selectAll').then(res => {\r\n        if (res.code === '200') {\r\n          // 初始化每个帖子时，加入 showReply 和 replies\r\n          this.tableData = res.data.map(item => ({\r\n            ...item,\r\n            showReply: false,\r\n            replyContent: '',\r\n            replies: item.replies || []  // 确保每个帖子都有一个回复数组\r\n          }))\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    commit() {\r\n      let data = {\r\n        content: this.content\r\n      }\r\n      this.$request.post('/fixed/add', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('提交成功，感谢您的发言')\r\n          this.content = null\r\n          this.load()\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    toggleReply(index) {\r\n      // 切换显示回复输入框\r\n      this.tableData[index].showReply = !this.tableData[index].showReply\r\n    },\r\n    submitReply(index) {\r\n      if (!this.tableData[index].replyContent) {\r\n        this.$message.error('请输入回复内容')\r\n        return\r\n      }\r\n      // 模拟提交回复的请求\r\n      this.$request.post('/fixed/reply', {\r\n        postId: this.tableData[index].id,\r\n        replyContent: this.tableData[index].replyContent\r\n      }).then(res => {\r\n        if (res.code === '200') {\r\n          // 将回复内容加入回复列表\r\n          this.tableData[index].replies.push(this.tableData[index].replyContent)\r\n          this.tableData[index].replyContent = ''\r\n          this.tableData[index].showReply = false\r\n          this.$message.success('回复成功')\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.post {\r\n  border: 1px solid #e0e0e0;\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  background-color: #f9f9f9;\r\n  border-radius: 8px;\r\n}\r\n\r\n.post-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.post-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.username {\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #888;\r\n}\r\n\r\n.post-body {\r\n  margin-top: 10px;\r\n}\r\n\r\n.post-content {\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  color: #333;\r\n}\r\n\r\n.reply-section {\r\n  margin-top: 10px;\r\n}\r\n\r\n.replies {\r\n  margin-top: 15px;\r\n}\r\n\r\n.reply {\r\n  margin-bottom: 8px;\r\n  padding: 5px;\r\n  background-color: #f1f1f1;\r\n  border-radius: 5px;\r\n}\r\n\r\n.reply-content {\r\n  font-size: 14px;\r\n  color: #555;\r\n}\r\n</style>\r\n"],"mappings":";AAmDA;EACAA,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,SAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAA;MACA,KAAAE,QAAA,CAAAC,GAAA,qBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA;UACA,KAAAR,SAAA,GAAAO,GAAA,CAAAd,IAAA,CAAAgB,GAAA