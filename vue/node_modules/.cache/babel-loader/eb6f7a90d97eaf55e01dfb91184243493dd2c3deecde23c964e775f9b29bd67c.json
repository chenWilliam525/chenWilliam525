{"ast":null,"code":"export default {\n  name: \"Examine\",\n  data() {\n    return {\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      status: null\n    };\n  },\n  created() {\n    this.load(1);\n  },\n  methods: {\n    load(pageNum) {\n      // 分页查询\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/user/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          status: this.status\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    reset() {\n      this.status = null;\n      this.load(1);\n    },\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    },\n    del(id) {\n      // 单个删除\n      this.$confirm('您确定删除吗？', '确认删除', {\n        type: \"warning\"\n      }).then(response => {\n        this.$request.delete('/user/delete/' + id).then(res => {\n          if (res.code === '200') {\n            this.$message.success('操作成功');\n            this.load(1);\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      }).catch(() => {});\n    },\n    handleExamine(row) {\n      let data = JSON.parse(JSON.stringify(row));\n      data.status = '已处理';\n      this.$request.put('/user/update', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('处理成功');\n          this.load(this.pageNum);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","tableData","pageNum","pageSize","total","status","created","load","methods","$request","get","params","then","res","list","reset","handleCurrentChange","del","id","$confirm","type","response","delete","code","$message","success","error","msg","catch","handleExamine","row","stringify","put"],"sources":["src/views/manager/Examine.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"search\">\r\n      <el-input placeholder=\"请输入状态查询\" style=\"width: 200px\" v-model=\"status\"></el-input>\r\n      <el-button type=\"info\" plain style=\"margin-left: 10px\" @click=\"load(1)\">查询</el-button>\r\n      <el-button type=\"warning\" plain style=\"margin-left: 10px\" @click=\"reset\">重置</el-button>\r\n    </div>\r\n\r\n    <div class=\"table\">\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"id\" label=\"序号\" width=\"80\" align=\"center\" sortable></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"用户名\" width=\"200\" align=\"center\"></el-table-column>\r\n\r\n        <!-- 处理状态 -->\r\n        <el-table-column prop=\"status\" label=\"处理状态\">\r\n          <template v-slot=\"scope\">\r\n            <!-- 显示 status 的值 -->\r\n\r\n            <!-- 如果 status 是 '已处理' 显示 '已处理'，否则显示 '待处理' -->\r\n            <el-tag type=\"success\" v-if=\"scope.row.status === '已通过'\">已通过</el-tag>\r\n            <el-tag type=\"danger\" v-elseif=\"scope.row.status === '已拒绝'\">已拒绝</el-tag>\r\n            <el-tag type=\"danger\" v-else=\"scope.row.status === '待处理'\">待处理</el-tag>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"操作\" width=\"180\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n\r\n            <el-button plain type=\"primary\" @click=\"handleExamine(scope.row)\" size=\"mini\" :disabled=\"scope.row.status === '已同意'\">处理</el-button>\r\n            <el-button plain type=\"primary\" @click=\"handleExamine(scope.row)\" size=\"mini\" :disabled=\"scope.row.status === '已处理'\">处理</el-button>\r\n\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <div class=\"pagination\">\r\n        <el-pagination\r\n                background\r\n                @current-change=\"handleCurrentChange\"\r\n                :current-page=\"pageNum\"\r\n                :page-sizes=\"[5, 10, 20]\"\r\n                :page-size=\"pageSize\"\r\n                layout=\"total, prev, pager, next\"\r\n                :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\nexport default {\r\n  name: \"Examine\",\r\n  data() {\r\n    return {\r\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\r\n      tableData: [],\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      status: null\r\n    }\r\n  },\r\n  created() {\r\n    this.load(1)\r\n  },\r\n  methods: {\r\n    load(pageNum) {  // 分页查询\r\n      if (pageNum) this.pageNum = pageNum\r\n      this.$request.get('/user/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          status: this.status,\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data?.list\r\n        this.total = res.data?.total\r\n      })\r\n    },\r\n    reset() {\r\n      this.status = null\r\n      this.load(1)\r\n    },\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum)\r\n    },\r\n    del(id) {   // 单个删除\r\n      this.$confirm('您确定删除吗？', '确认删除', {type: \"warning\"}).then(response => {\r\n        this.$request.delete('/user/delete/' + id).then(res => {\r\n          if (res.code === '200') {\r\n            this.$message.success('操作成功')\r\n            this.load(1)\r\n          } else {\r\n            this.$message.error(res.msg)\r\n          }\r\n        })\r\n      }).catch(() => {\r\n      })\r\n    },\r\n    handleExamine(row) {\r\n      let data = JSON.parse(JSON.stringify(row))\r\n      data.status = '已处理'\r\n      this.$request.put('/user/update', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('处理成功')\r\n          this.load(this.pageNum)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>\r\n"],"mappings":"AAoDA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,KAAAL,OAAA;MAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAO,QAAA,CAAAC,GAAA;QACAC,MAAA;UACAT,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAE,MAAA,OAAAA;QACA;MACA,GAAAO,IAAA,CAAAC,GAAA;QACA,KAAAZ,SAAA,GAAAY,GAAA,CAAAlB,IAAA,EAAAmB,IAAA;QACA,KAAAV,KAAA,GAAAS,GAAA,CAAAlB,IAAA,EAAAS,KAAA;MACA;IACA;IACAW,MAAA;MACA,KAAAV,MAAA;MACA,KAAAE,IAAA;IACA;IACAS,oBAAAd,OAAA;MACA,KAAAK,IAAA,CAAAL,OAAA;IACA;IACAe,IAAAC,EAAA;MAAA;MACA,KAAAC,QAAA;QAAAC,IAAA;MAAA,GAAAR,IAAA,CAAAS,QAAA;QACA,KAAAZ,QAAA,CAAAa,MAAA,mBAAAJ,EAAA,EAAAN,IAAA,CAAAC,GAAA;UACA,IAAAA,GAAA,CAAAU,IAAA;YACA,KAAAC,QAAA,CAAAC,OAAA;YACA,KAAAlB,IAAA;UACA;YACA,KAAAiB,QAAA,CAAAE,KAAA,CAAAb,GAAA,CAAAc,GAAA;UACA;QACA;MACA,GAAAC,KAAA,QACA;IACA;IACAC,cAAAC,GAAA;MACA,IAAAnC,IAAA,GAAAE,IAAA,CAAAC,KAAA,CAAAD,IAAA,CAAAkC,SAAA,CAAAD,GAAA;MACAnC,IAAA,CAAAU,MAAA;MACA,KAAAI,QAAA,CAAAuB,GAAA,iBAAArC,IAAA,EAAAiB,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAU,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAlB,IAAA,MAAAL,OAAA;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}