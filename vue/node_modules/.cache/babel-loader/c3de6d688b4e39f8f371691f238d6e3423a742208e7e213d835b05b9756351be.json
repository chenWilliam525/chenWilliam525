{"ast":null,"code":"export default {\n  name: \"Complaint\",\n  data() {\n    return {\n      tableData: [],\n      pageNum: 1,\n      pageSize: 10,\n      total: 0,\n      status: null\n    };\n  },\n  created() {\n    this.load(1);\n  },\n  methods: {\n    // 删除操作\n    del(id) {\n      this.$confirm('您确定删除吗？', '确认删除', {\n        type: \"warning\"\n      }).then(response => {\n        this.$request.delete('/complaint/delete/' + id).then(res => {\n          if (res.code === '200') {\n            this.$message.success('操作成功');\n            this.load(1); // 刷新数据\n          } else {\n            this.$message.error(res.msg);\n          }\n        });\n      }).catch(() => {});\n    },\n    // 分页查询\n    load(pageNum) {\n      if (pageNum) this.pageNum = pageNum;\n      this.$request.get('/complaint/selectPage', {\n        params: {\n          pageNum: this.pageNum,\n          pageSize: this.pageSize,\n          status: this.status\n        }\n      }).then(res => {\n        this.tableData = res.data?.list;\n        this.total = res.data?.total;\n      });\n    },\n    // 状态更新（同意或拒绝）\n    handleStatusUpdate(row, newStatus) {\n      let data = {\n        id: row.id,\n        status: newStatus\n      };\n      this.$request.put('/complaint/updateStatus', data).then(res => {\n        if (res.code === '200') {\n          this.$message.success('状态更新成功');\n          this.load(this.pageNum); // 刷新数据\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    // 刷新当前页数据\n    handleCurrentChange(pageNum) {\n      this.load(pageNum);\n    }\n  }\n};","map":{"version":3,"names":["name","data","tableData","pageNum","pageSize","total","status","created","load","methods","del","id","$confirm","type","then","response","$request","delete","res","code","$message","success","error","msg","catch","get","params","list","handleStatusUpdate","row","newStatus","put","handleCurrentChange"],"sources":["src/views/manager/Examine.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"table\">\r\n      <el-table :data=\"tableData\" stripe>\r\n        <el-table-column prop=\"id\" label=\"序号\" width=\"80\" align=\"center\" sortable></el-table-column>\r\n        <el-table-column prop=\"content\" label=\"反馈内容\" width=\"500px\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"time\" label=\"提交时间\" show-overflow-tooltip></el-table-column>\r\n        <el-table-column prop=\"name\" label=\"业主姓名\"></el-table-column>\r\n        <el-table-column prop=\"status\" label=\"处理状态\">\r\n          <template v-slot=\"scope\">\r\n            <el-tag v-if=\"scope.row.status === '已同意'\" type=\"success\">已同意</el-tag>\r\n            <el-tag v-else-if=\"scope.row.status === '已拒绝'\" type=\"danger\">已拒绝</el-tag>\r\n            <el-tag v-else>待处理</el-tag>\r\n          </template>\r\n        </el-table-column>\r\n\r\n        <el-table-column label=\"操作\" width=\"180\" align=\"center\">\r\n          <template v-slot=\"scope\">\r\n            <!-- 同意按钮 -->\r\n            <el-button\r\n                    plain\r\n                    type=\"success\"\r\n                    @click=\"handleStatusUpdate(scope.row, '已同意')\"\r\n                    size=\"mini\"\r\n                    :disabled=\"scope.row.status === '已同意' || scope.row.status === '已拒绝'\">\r\n              同意\r\n            </el-button>\r\n\r\n            <!-- 拒绝按钮 -->\r\n            <el-button\r\n                    plain\r\n                    type=\"danger\"\r\n                    @click=\"handleStatusUpdate(scope.row, '已拒绝')\"\r\n                    size=\"mini\"\r\n                    :disabled=\"scope.row.status === '已同意' || scope.row.status === '已拒绝'\">\r\n              拒绝\r\n            </el-button>\r\n\r\n            <!-- 删除按钮 -->\r\n            <el-button\r\n                    plain\r\n                    type=\"danger\"\r\n                    size=\"mini\"\r\n                    @click=\"del(scope.row.id)\">\r\n              删除\r\n            </el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n\r\n      <div class=\"pagination\">\r\n        <el-pagination\r\n                background\r\n                @current-change=\"handleCurrentChange\"\r\n                :current-page=\"pageNum\"\r\n                :page-sizes=\"[5, 10, 20]\"\r\n                :page-size=\"pageSize\"\r\n                layout=\"total, prev, pager, next\"\r\n                :total=\"total\">\r\n        </el-pagination>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"Complaint\",\r\n  data() {\r\n    return {\r\n      tableData: [],\r\n      pageNum: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      status: null\r\n    }\r\n  },\r\n  created() {\r\n    this.load(1)\r\n  },\r\n  methods: {\r\n    // 删除操作\r\n    del(id) {\r\n      this.$confirm('您确定删除吗？', '确认删除', { type: \"warning\" }).then(response => {\r\n        this.$request.delete('/complaint/delete/' + id).then(res => {\r\n          if (res.code === '200') {\r\n            this.$message.success('操作成功')\r\n            this.load(1)  // 刷新数据\r\n          } else {\r\n            this.$message.error(res.msg)\r\n          }\r\n        })\r\n      }).catch(() => {})\r\n    },\r\n\r\n    // 分页查询\r\n    load(pageNum) {\r\n      if (pageNum) this.pageNum = pageNum\r\n      this.$request.get('/complaint/selectPage', {\r\n        params: {\r\n          pageNum: this.pageNum,\r\n          pageSize: this.pageSize,\r\n          status: this.status\r\n        }\r\n      }).then(res => {\r\n        this.tableData = res.data?.list\r\n        this.total = res.data?.total\r\n      })\r\n    },\r\n\r\n    // 状态更新（同意或拒绝）\r\n    handleStatusUpdate(row, newStatus) {\r\n      let data = { id: row.id, status: newStatus }\r\n      this.$request.put('/complaint/updateStatus', data).then(res => {\r\n        if (res.code === '200') {\r\n          this.$message.success('状态更新成功')\r\n          this.load(this.pageNum)  // 刷新数据\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n\r\n    // 刷新当前页数据\r\n    handleCurrentChange(pageNum) {\r\n      this.load(pageNum)\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.table {\r\n  margin-top: 20px;\r\n}\r\n.pagination {\r\n  margin-top: 20px;\r\n}\r\n</style>\r\n"],"mappings":"AAkEA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,QAAA;MACAC,KAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACA;IACAC,IAAAC,EAAA;MACA,KAAAC,QAAA;QAAAC,IAAA;MAAA,GAAAC,IAAA,CAAAC,QAAA;QACA,KAAAC,QAAA,CAAAC,MAAA,wBAAAN,EAAA,EAAAG,IAAA,CAAAI,GAAA;UACA,IAAAA,GAAA,CAAAC,IAAA;YACA,KAAAC,QAAA,CAAAC,OAAA;YACA,KAAAb,IAAA;UACA;YACA,KAAAY,QAAA,CAAAE,KAAA,CAAAJ,GAAA,CAAAK,GAAA;UACA;QACA;MACA,GAAAC,KAAA;IACA;IAEA;IACAhB,KAAAL,OAAA;MACA,IAAAA,OAAA,OAAAA,OAAA,GAAAA,OAAA;MACA,KAAAa,QAAA,CAAAS,GAAA;QACAC,MAAA;UACAvB,OAAA,OAAAA,OAAA;UACAC,QAAA,OAAAA,QAAA;UACAE,MAAA,OAAAA;QACA;MACA,GAAAQ,IAAA,CAAAI,GAAA;QACA,KAAAhB,SAAA,GAAAgB,GAAA,CAAAjB,IAAA,EAAA0B,IAAA;QACA,KAAAtB,KAAA,GAAAa,GAAA,CAAAjB,IAAA,EAAAI,KAAA;MACA;IACA;IAEA;IACAuB,mBAAAC,GAAA,EAAAC,SAAA;MACA,IAAA7B,IAAA;QAAAU,EAAA,EAAAkB,GAAA,CAAAlB,EAAA;QAAAL,MAAA,EAAAwB;MAAA;MACA,KAAAd,QAAA,CAAAe,GAAA,4BAAA9B,IAAA,EAAAa,IAAA,CAAAI,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAC,QAAA,CAAAC,OAAA;UACA,KAAAb,IAAA,MAAAL,OAAA;QACA;UACA,KAAAiB,QAAA,CAAAE,KAAA,CAAAJ,GAAA,CAAAK,GAAA;QACA;MACA;IACA;IAEA;IACAS,oBAAA7B,OAAA;MACA,KAAAK,IAAA,CAAAL,OAAA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}